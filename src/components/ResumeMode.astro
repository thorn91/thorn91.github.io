    transition:
      left 1050ms cubic-bezier(0.65, 0, 0.35, 1),
      top 1050ms cubic-bezier(0.65, 0, 0.35, 1),
      width 1050ms cubic-bezier(0.65, 0, 0.35, 1),
      height 1050ms cubic-bezier(0.65, 0, 0.35, 1),
      box-shadow 600ms ease,
      background-color 360ms ease,
      opacity 360ms ease;
  }
  .rm.rm-on .rm-spot { opacity: 1; }
  .rm.rm-on[data-view='card'] .rm-spot { background: var(--paper-lit); }
