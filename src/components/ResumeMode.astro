---
// Resume mode: a business card over the page, then a guided tour of my work.
// The camera moves the page itself (#page) across to a table of plates that
// only exists while the tour is open. Each plate is a drawing; each stop's
// copy lives in a <template data-stop>. Chapters group the stops, and each
// chapter is its own short timeline in the bar. To add a stop or a chapter,
// see "How to add a chapter or a stop" on the Resume mode canvas.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const email = 'tom@prettygoodsoftware.llc';
const studio = 'https://prettygoodsoftware.llc';

const history = [
  ['Now', 'Tech lead on a back-office and accounting application.'],
  ['Also', 'Pretty Good Software: two iPhone apps, designed and built by me.'],
  ['Before', 'Founding engineer at CollectivIQ, now a part-time technical advisor there.'],
  ['School', 'Rhodes College (B.S. Neuroscience), University of Georgia (B.S. Computer Science)'],
];

const entFlow = [
  ['Policy model', 'A policy attaches to any node of the organization tree'],
  ['Resolution', 'Each user resolves to the nearest ancestor with a policy'],
  ['Domain events', 'Access changes are published as events'],
  ['Admin UI', 'The tree and its policies, managed on one screen'],
];
const glFlow = [
  ['Transaction', 'The journal lines of one business event, posted together'],
  ['Invariants', 'Debits equal credits, checked on every transaction'],
  ['Corrections', 'Reversal and amendment flows'],
  ['Stack', 'Java, Spring, JPA'],
];
const brFlow = [
  ['Statement', 'The bank’s record of what cleared'],
  ['Ledger', 'What the books say happened'],
  ['Reconcile', 'Each side checked against the other'],
  ['Reporting', 'The financial reporting layer, built on top'],
];
const callsFlow = [
  ['Decisions card', 'Each call with its options, the context, and what changes for whom'],
  ['Who decided', 'Me, my pick from its recommendation, or handed to the agent'],
  ['Never blocks', 'The build carries on with the recommended answer while a call is open'],
];
const anywhereFlow = [
  ['Any harness', 'Claude Code, Codex, Cursor and Devin get the same rules'],
  ['Any place', 'On my machine, or unattended in the cloud with a handback when I return'],
  ['Any job', 'Building, visual testing, tickets and docs, pull request review'],
  ['Any work', 'The day job, my apps, this site, and agentom itself'],
];
const rvFlow = [
  ['Reviewed', '1,500+ pull requests across a 20-engineer org'],
  ['Authored', '970+ pull requests'],
  ['Frontend', 'Angular guides, ESLint rules and UX standards'],
  ['Incidents', 'Escalation point for production issues on other teams’ systems'],
];
const ciqFlow = [
  ['Web app', 'Built from scratch: Angular, signals, Web Awesome'],
  ['Streaming', 'Every model’s answer streams at once, one tab per model'],
  ['Arbiter', 'Compares the answers for agreement, contradiction and what only one found'],
  ['Backend', 'Python and FastAPI: streaming, auth, threads, slow providers'],
];
const reviewFlow = [
  ['Flows', 'A scenario lights its path through screen, endpoint, domain and data'],
  ['Rules', 'Each one with where the code enforces it, and the evidence'],
  ['Code', 'Pasted from git by a script, never typed by the model'],
];

const ledger = [
  {
    title: 'Supplier invoice', note: 'Oct 3 · keyed as 1,240.00', total: '1,240.00',
    lines: [['Food inventory', '1,240.00', ''], ['Accounts payable', '', '1,240.00']],
  },
  {
    title: 'Reversal', note: 'Oct 5 · reverses Oct 3', total: '1,240.00',
    lines: [['Accounts payable', '1,240.00', ''], ['Food inventory', '', '1,240.00']],
  },
  {
    title: 'Amended invoice', note: 'Oct 5 · the right amount', total: '1,420.00',
    lines: [['Food inventory', '1,420.00', ''], ['Accounts payable', '', '1,420.00']],
  },
];

const bank = [
  ['Oct 2 · Deposit', '+3,800.00', 'Oct 2 · Sales deposit', '3,800.00'],
  ['Oct 7 · Check 1042', '−1,420.00', 'Oct 5 · Check 1042, supplier', '1,420.00'],
  ['Oct 9 · Card fees', '−86.40', 'Oct 9 · Merchant fees', '86.40'],
];

const models = ['GPT', 'Claude', 'Gemini', 'Grok'];
const lanes = ['Screen', 'Endpoint', 'Domain', 'Data'];
---

<div id="resume-mode" class="rm" role="dialog" aria-modal="true" aria-label="Resume mode" hidden>
  <div class="rm-scrim" aria-hidden="true"></div>
  <div class="rm-offset" aria-hidden="true"></div>
  <div class="rm-spot" aria-hidden="true"></div>
  <div class="rm-slug" aria-hidden="true"></div>
  <button type="button" class="rm-zoom-hit" aria-label="Enlarge the drawing"><span>Enlarge</span></button>
  <div class="rm-zoom" role="dialog" aria-label="The drawing, full size" hidden>
    <button type="button" class="rm-btn rm-btn-ghost rm-zoom-close">Close <span aria-hidden="true">×</span></button>
    <div class="rm-zoom-body"></div>
  </div>

  <div class="rm-card" hidden>
    <div class="rm-card-head rise" style="--d: 140ms">
      <div>
        <h2 class="rm-name" tabindex="-1">Thomas Horn</h2>
        <p class="rm-role">Software engineer in Raleigh, North Carolina</p>
      </div>
      <svg class="rm-card-mark" viewBox="0 0 100 100" aria-hidden="true">
        <clipPath id="rmlens"><circle cx="40" cy="60" r="30"></circle></clipPath>
        <circle cx="40" cy="60" r="30" fill="#4b3a8c"></circle>
        <circle cx="60" cy="40" r="30" fill="#ffb511"></circle>
        <circle cx="60" cy="40" r="30" fill="#4b2909" clip-path="url(#rmlens)"></circle>
      </svg>
    </div>
    <div class="rm-rule rise" style="--d: 220ms"></div>
    <dl class="rm-history">
      {history.map(([k, v], i) => (
        <div class="rise" style={`--d: ${300 + i * 70}ms`}>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
    <div class="rm-card-actions rise" style="--d: 640ms">
      <button type="button" class="rm-btn rm-btn-ink" data-rm-tour>Tour my work <span aria-hidden="true">→</span></button>
      <a class="rm-btn rm-btn-ghost" href={`${base}thomas-horn-resume.pdf`}>Resume PDF</a>
      <a class="rm-email" href={`mailto:${email}`}>{email}</a>
    </div>
  </div>

  <div class="rm-panel-wrap">
    <section class="rm-panel" aria-live="polite">
      <div class="rm-panel-ink" aria-hidden="true"></div>
      <div class="rm-panel-box">
        <div class="rm-panel-body"></div>
        <div class="rm-step-nav">
          <button type="button" class="rm-btn rm-btn-ghost rm-back" aria-label="Previous stop">←</button>
          <span class="rm-step-count"></span>
          <button type="button" class="rm-btn rm-next"></button>
        </div>
      </div>
    </section>
  </div>

  <div class="rm-bar">
    <button type="button" class="rm-bar-title" data-rm-card>
      <svg viewBox="0 0 100 100" width="24" height="24" aria-hidden="true">
        <clipPath id="rmbarlens"><circle cx="40" cy="60" r="30"></circle></clipPath>
        <circle cx="40" cy="60" r="30" fill="#4b3a8c"></circle>
        <circle cx="60" cy="40" r="30" fill="#ffb511"></circle>
        <circle cx="60" cy="40" r="30" fill="#4b2909" clip-path="url(#rmbarlens)"></circle>
      </svg>
      <span>Resume mode</span>
    </button>
    <div class="rm-project">
      <button type="button" class="rm-project-btn" aria-haspopup="menu" aria-expanded="false"></button>
      <div class="rm-menu" role="menu" hidden></div>
    </div>
    <nav class="rm-stops" aria-label="Stops in this project"></nav>
    <button type="button" class="rm-btn rm-btn-ghost rm-exit">Exit <span class="rm-exit-long">resume mode</span> <span aria-hidden="true">×</span></button>
  </div>

  <!-- The table of plates. The script moves it inside #page, so the camera
       carries it with the page; it shows only while resume mode is open. -->
  <div class="rm-table" aria-hidden="true">
    <figure class="rm-plate" data-plate="ent">
      <svg class="rm-tree" viewBox="0 0 576 330" role="img" aria-label="An organization tree: a restaurant group over Brand A and Brand B, Brand A over Locations 1 and 2, Brand B over Location 3. A policy sits on Brand A, and a manager at Location 2 resolves up to it.">
        <rect class="scope" x="1" y="98" width="290" height="226" />
        <path class="edge" d="M288 44V87M140 87H436M140 87V130M436 87V130M140 174V218M70 218H210M70 218V262M210 218V262M436 174V262" />
        <path class="resolve" d="M210 262V218H140V182" />
        <path class="resolve-head" d="M133 186L140 176L147 186" />
        <rect class="node" x="208" y="0" width="160" height="44" />
        <text class="label" x="288" y="22">Restaurant group</text>
        <rect class="node" x="65" y="130" width="150" height="44" />
        <text class="label" x="140" y="152">Brand A</text>
        <rect class="tag" x="111" y="106" width="58" height="20" />
        <text class="tag-text" x="140" y="116">Policy</text>
        <rect class="node" x="361" y="130" width="150" height="44" />
        <text class="label" x="436" y="152">Brand B</text>
        <rect class="node" x="10" y="262" width="120" height="44" />
        <text class="loc" x="70" y="284">Location 1</text>
        <rect class="node on" x="150" y="262" width="120" height="44" />
        <text class="loc on" x="210" y="284">Location 2</text>
        <rect class="node" x="376" y="262" width="120" height="44" />
        <text class="loc" x="436" y="284">Location 3</text>
      </svg>
      <p class="rm-legend"><i class="resolve"></i>Resolves up to the nearest policy<i class="scope"></i>What the manager sees</p>
      <figcaption>A manager at Location 2 resolves to Brand A’s policy, so they see Brand A and its locations. Brand B stays out of view.</figcaption>
    </figure>

    <figure class="rm-plate" data-plate="gl">
      <p class="rm-example">An example, not customer data: a supplier invoice for 1,420.00, keyed as 1,240.00</p>
      {ledger.map((t) => (
        <div class="rm-txn">
          <div class="rm-txn-head"><strong>{t.title}</strong><span>{t.note}</span></div>
          <div class="rm-txn-row rm-txn-cols"><span>Account</span><span>Debit</span><span>Credit</span></div>
          {t.lines.map(([a, d, c]) => (
            <div class="rm-txn-row"><span>{a}</span><span class="num">{d}</span><span class="num">{c}</span></div>
          ))}
          <div class="rm-txn-row rm-txn-total"><span><span class="rm-chip">Balanced</span></span><span class="num">{t.total}</span><span class="num">{t.total}</span></div>
        </div>
      ))}
      <figcaption>The first transaction stays on the books. The reversal cancels it, and the amended invoice posts the right amount, so the history shows what happened and when.</figcaption>
    </figure>

    <figure class="rm-plate" data-plate="br">
      <p class="rm-example">An example month, not customer data</p>
      <div class="rm-rec rm-rec-head"><span>Bank statement</span><span></span><span>Ledger</span></div>
      {bank.map(([b, ba, l, la]) => (
        <div class="rm-rec">
          <div class="rm-rec-cell"><span>{b}</span><span class="num">{ba}</span></div>
          <i class="rm-join"></i>
          <div class="rm-rec-cell"><span>{l}</span><span class="num">{la}</span></div>
        </div>
      ))}
      <div class="rm-rec">
        <div class="rm-rec-cell rm-rec-empty"><span>Not on the statement</span></div>
        <i></i>
        <div class="rm-rec-cell rm-rec-open"><span>Oct 30 · Check 1047</span><span class="num">610.00, not cleared yet</span></div>
      </div>
      <div class="rm-rec-sum">
        <div><span>Bank balance, Oct 31</span><span class="num">12,450.00</span></div>
        <div><span>Less the check not cleared yet</span><span class="num">−610.00</span></div>
        <div class="rm-rec-book"><span>Book balance, Oct 31</span><span class="num">11,840.00</span></div>
        <span class="rm-chip">Reconciled</span>
      </div>
    </figure>

    <figure class="rm-plate" data-plate="rv">
      <div class="rm-counts">
        <div><b>1,500+</b><span>pull requests reviewed, most outside Operations</span></div>
        <div><b>970+</b><span>pull requests authored</span></div>
      </div>
      <div class="rm-roles">
        <div><strong>Second reviewer</strong><span>on every architecture PR</span></div>
        <div><strong>Frontend architecture</strong><span>owned: guides, lint rules, UX standards</span></div>
        <div><strong>Backend architecture</strong><span>developed and enforced with the lead architect</span></div>
      </div>
      <figcaption>Across an engineering org of 20.</figcaption>
    </figure>

    <figure class="rm-plate" data-plate="ciq">
      <div class="rm-box rm-prompt"><strong>One prompt</strong></div>
      <div class="rm-models">
        {models.map((m, i) => (
          <div class="rm-model">
            <strong>{m}</strong>
            <i style={`--w: ${[92, 70, 84, 58][i]}%`}></i>
            <i style={`--w: ${[64, 88, 50, 76][i]}%`}></i>
            <i style={`--w: ${[40, 52, 66, 30][i]}%`}></i>
          </div>
        ))}
      </div>
      <div class="rm-box rm-box-ink rm-arbiter">
        <strong>Arbiter</strong>
        <span class="rm-tags"><span class="rm-chip">Agreement</span><span class="rm-chip">Contradiction</span><span class="rm-chip">Only one found it</span></span>
      </div>
      <figcaption>Every answer streams at once, one tab per model, then the Arbiter compares them.</figcaption>
    </figure>

    <figure class="rm-plate" data-plate="theory">
      <div class="rm-call">
        <p class="rm-call-q">Should a paused location keep its menu?</p>
        <div class="rm-call-opt rm-call-rec"><b>A</b><span><strong>Keep it, hidden</strong>Nothing is lost if it comes back. Recommended.</span></div>
        <div class="rm-call-opt"><b>B</b><span><strong>Archive it</strong>The menu leaves every report until restored.</span></div>
        <div class="rm-call-opt rm-call-else"><b>C</b><span><strong>Something else</strong>Say it in my own words.</span></div>
        <p class="rm-call-who"><span class="rm-chip">Decided</span> I took the recommendation</p>
      </div>
      <figcaption>An illustration, not a real decision. The build keeps going on the recommended answer while the card waits.</figcaption>
    </figure>

    <figure class="rm-plate" data-plate="loop">
      <div class="rm-lanes">
        {lanes.map((l, i) => (
          <div class="rm-lane"><span>{l}</span><b class:list={[i < 3 && 'on']}>{['Save button', 'POST /menus', 'Menu rules', 'menus table'][i]}</b></div>
        ))}
      </div>
      <div class="rm-rules">
        <div><span class="rm-chip">Rule</span>A menu belongs to one location<em>Enforced in Menu rules · checked by 2 tests</em></div>
        <div><span class="rm-chip">Rule</span>Prices never go below zero<em>Enforced in Menu rules · reflected on the Save button</em></div>
      </div>
      <figcaption>An illustration of the review view: one scenario's path through the layers, and each rule with where the code holds it.</figcaption>
    </figure>

    <figure class="rm-plate" data-plate="anywhere">
      <div class="rm-scales">
        <div><b>Any harness</b><span>Claude Code, Codex, Cursor, Devin</span></div>
        <div><b>Any place</b><span>My machine or the cloud</span></div>
        <div><b>Any work</b><span>The day job, my apps, the rest</span></div>
      </div>
      <div class="rm-loopline"><span>The same rules, and the calls still come back to me</span></div>
      <p class="rm-plate-label">Jobs it runs</p>
      <div class="rm-tags">{['Build', 'Visual testing', 'Tickets and docs', 'PR review'].map((h) => <span class="rm-chip">{h}</span>)}</div>
    </figure>

    <figure class="rm-plate" data-plate="apps">
      <div class="rm-apps">
        <a class="rm-app" href={`${studio}/?tour=tally`} tabindex="-1">
          <img src={`${base}resume/tally.png`} width="200" height="434" alt="A logged meal in Tally." />
          <strong>Tally</strong>
        </a>
        <a class="rm-app" href={`${studio}/?tour=coaching`} tabindex="-1">
          <img src={`${base}resume/coaching.jpg`} width="200" height="434" alt="A squat paused on one frame in Pretty Good Video Coaching." />
          <strong>Video Coaching</strong>
        </a>
      </div>
    </figure>
  </div>

  <template data-stop="ent" data-seg="Enterprise access" data-slug="Buyers Edge · enterprise access">
    <p class="rm-meta-line rise">Buyers Edge, enterprise groups</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">Access that follows the shape of the company</h2>
    <p class="rm-lede rise" style="--d: 120ms">I lead the enterprise work in Operations: making the platform fit large groups that run many brands and locations. Its first major piece is an authorization system I designed and built from scratch.</p>
    <ol class="rm-flow">
      {entFlow.map(([k, v], i) => <li class="rise" style={`--d: ${200 + i * 50}ms`}><span>{k}</span>{v}</li>)}
    </ol>
    <p class="rm-text rise" style="--d: 440ms">It opened the platform to large multi-brand operators and made acquisitions simpler to onboard.</p>
  </template>

  <template data-stop="gl" data-seg="General ledger" data-slug="Buyers Edge · general ledger">
    <p class="rm-meta-line rise">Buyers Edge, the general ledger</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">Double-entry, one transaction at a time</h2>
    <p class="rm-lede rise" style="--d: 120ms">I rebuilt the general ledger with the lead architect, moving it from single journal entries to transactions. Each transaction carries the lines of one business event, and the accounting rules are enforced on it before it posts.</p>
    <ol class="rm-flow">
      {glFlow.map(([k, v], i) => <li class="rise" style={`--d: ${200 + i * 50}ms`}><span>{k}</span>{v}</li>)}
    </ol>
  </template>

  <template data-stop="br" data-seg="Bank rec" data-slug="Buyers Edge · bank reconciliation">
    <p class="rm-meta-line rise">Buyers Edge, bank reconciliation</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">Proving the books match the bank</h2>
    <p class="rm-lede rise" style="--d: 120ms">I architected and built bank reconciliation, and the financial reporting layer on top of it.</p>
    <ol class="rm-flow">
      {brFlow.map(([k, v], i) => <li class="rise" style={`--d: ${200 + i * 50}ms`}><span>{k}</span>{v}</li>)}
    </ol>
    <p class="rm-meta rise" style="--d: 440ms">Java · Spring · Angular</p>
  </template>

  <template data-stop="rv" data-seg="Review" data-slug="Buyers Edge · architecture">
    <p class="rm-meta-line rise">Buyers Edge, architecture</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">Second reviewer on every architecture PR</h2>
    <p class="rm-lede rise" style="--d: 120ms">I own the frontend architecture and help set the backend’s with the lead architect. Most of the code I review is outside my own team.</p>
    <ol class="rm-flow">
      {rvFlow.map(([k, v], i) => <li class="rise" style={`--d: ${200 + i * 50}ms`}><span>{k}</span>{v}</li>)}
    </ol>
  </template>

  <template data-stop="ciq" data-seg="Four models" data-slug="CollectivIQ">
    <p class="rm-meta-line rise">CollectivIQ, founding engineer</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">Asking four models at once, then comparing</h2>
    <p class="rm-lede rise" style="--d: 120ms">Buyers Edge’s AI platform sends each prompt to GPT, Claude, Gemini and Grok in parallel and reconciles their answers. I built it from zero to handoff, then stepped back to advise part time.</p>
    <ol class="rm-flow">
      {ciqFlow.map(([k, v], i) => <li class="rise" style={`--d: ${200 + i * 50}ms`}><span>{k}</span>{v}</li>)}
    </ol>
  </template>

  <template data-stop="theory" data-seg="The calls" data-slug="Working with agents · the calls">
    <p class="rm-meta-line rise">Working with agents, the calls</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">The agent builds, the decisions come back to me</h2>
    <p class="rm-lede rise" style="--d: 120ms">agentom is my harness for coding with agents. Even when I take the agent’s recommendation, I see every decision laid out with its options and context, as if we made it together.</p>
    <ol class="rm-flow">
      {callsFlow.map(([k, v], i) => <li class="rise" style={`--d: ${200 + i * 50}ms`}><span>{k}</span>{v}</li>)}
    </ol>
  </template>

  <template data-stop="loop" data-seg="The review" data-slug="Working with agents · the review">
    <p class="rm-meta-line rise">Working with agents, the review</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">Reviewing the work as flows and rules</h2>
    <p class="rm-lede rise" style="--d: 120ms">What the agent built comes back as one view I can zoom into, instead of a long diff: how the code flows, what must hold, and where the code holds it.</p>
    <ol class="rm-flow">
      {reviewFlow.map(([k, v], i) => <li class="rise" style={`--d: ${200 + i * 50}ms`}><span>{k}</span>{v}</li>)}
    </ol>
  </template>

  <template data-stop="anywhere" data-seg="Anything" data-slug="Working with agents · anything">
    <p class="rm-meta-line rise">Working with agents, anything</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">Whatever I throw at it, wherever it runs</h2>
    <p class="rm-lede rise" style="--d: 120ms">agentom is built for one person: me. It bends to the job instead of the other way round, and the decisions still come back to me.</p>
    <ol class="rm-flow">
      {anywhereFlow.map(([k, v], i) => <li class="rise" style={`--d: ${200 + i * 50}ms`}><span>{k}</span>{v}</li>)}
    </ol>
  </template>

  <template data-stop="apps" data-seg="Tally and Coaching" data-slug="Pretty Good Software">
    <p class="rm-meta-line rise">Pretty Good Software</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">Two iPhone apps, with their own tours</h2>
    <p class="rm-lede rise" style="--d: 120ms">Tally and Pretty Good Video Coaching, designed and built by me. Each has a technical tour on the studio site.</p>
    <ul class="rm-links">
      <li class="rise" style="--d: 200ms"><span><strong>Tally</strong>An iPhone app for logging meals.</span><a href={`${studio}/?tour=tally`}>Technical tour <span aria-hidden="true">↗</span></a></li>
      <li class="rise" style="--d: 260ms"><span><strong>Video Coaching</strong>An iPhone app for physical therapists.</span><a href={`${studio}/?tour=coaching`}>Technical tour <span aria-hidden="true">↗</span></a></li>
    </ul>
  </template>

  <template data-end>
    <p class="rm-meta-line rise">Thomas Horn</p>
    <h2 class="rm-title rise" style="--d: 60ms" tabindex="-1">That’s the tour</h2>
    <p class="rm-lede rise" style="--d: 120ms">Questions about how any of it works are welcome.</p>
    <a class="rm-btn rm-btn-ink rm-btn-block rise" style="--d: 200ms" href="mailto:tom@prettygoodsoftware.llc">tom@prettygoodsoftware.llc</a>
    <div class="rm-end-actions rise" style="--d: 260ms">
      <button type="button" class="rm-btn rm-btn-ghost" data-end-card>Back to the card</button>
      <button type="button" class="rm-btn rm-btn-ghost" data-end-exit>Back to the site</button>
    </div>
  </template>
</div>

<script>
  type Box = { x: number; y: number; w: number; h: number };
  type Chapter = { key: string; name: string; years: string; stops: string[] };

  // The order here is the order of the tour and of the bar.
  const CHAPTERS: Chapter[] = [
    { key: 'buyers-edge', name: 'Buyers Edge', years: 'since 2021', stops: ['ent', 'gl', 'br', 'rv'] },
    { key: 'agents', name: 'Working with agents', years: 'agentom', stops: ['theory', 'loop', 'anywhere'] },
    { key: 'collectiviq', name: 'CollectivIQ', years: 'since 2025', stops: ['ciq'] },
    { key: 'apps', name: 'Apps', years: '2026', stops: ['apps'] },
    { key: 'contact', name: 'Contact', years: '', stops: ['end'] },
  ];
  const ORDER = ['card', ...CHAPTERS.flatMap((c) => c.stops)];
  const BAR = 64;

  const root = document.getElementById('resume-mode') as HTMLElement;
  const page = document.getElementById('page') as HTMLElement;
  const q = <T extends Element>(sel: string) => root.querySelector(sel) as T;
  const card = q<HTMLElement>('.rm-card');
  const spot = q<HTMLElement>('.rm-spot');
  const offset = q<HTMLElement>('.rm-offset');
  const slug = q<HTMLElement>('.rm-slug');
  const panelBody = q<HTMLElement>('.rm-panel-body');
  const stepNav = q<HTMLElement>('.rm-step-nav');
  const stepCount = q<HTMLElement>('.rm-step-count');
  const back = q<HTMLButtonElement>('.rm-back');
  const next = q<HTMLButtonElement>('.rm-next');
  const projectBtn = q<HTMLButtonElement>('.rm-project-btn');
  const menu = q<HTMLElement>('.rm-menu');
  const stopsNav = q<HTMLElement>('.rm-stops');
  const table = q<HTMLElement>('.rm-table');
  const zoomHit = q<HTMLButtonElement>('.rm-zoom-hit');
  const zoom = q<HTMLElement>('.rm-zoom');
  const zoomBody = q<HTMLElement>('.rm-zoom-body');
  const toggle = document.getElementById('resume-toggle') as HTMLButtonElement | null;

  page.appendChild(table);

  const stopTemplates = new Map<string, HTMLTemplateElement>();
  root.querySelectorAll<HTMLTemplateElement>('template[data-stop]').forEach((t) => stopTemplates.set(t.dataset.stop!, t));
  const endTemplate = q<HTMLTemplateElement>('template[data-end]');
  const plateOf = (id: string) => table.querySelector<HTMLElement>(`[data-plate="${id}"]`)!;
  const chapterOf = (id: string) => CHAPTERS.find((c) => c.stops.includes(id));
  const labelOf = (id: string) => (id === 'end' ? 'Email' : stopTemplates.get(id)?.dataset.seg ?? '');

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const duration = () => (reduced.matches ? 0 : 1050);

  let view = '';
  let saved = 0;
  let opener: HTMLElement | null = null;
  let busy = false;
  let menuOpen = false;

  const wide = () => innerWidth >= 1000;

  // Position of an element inside the page, ignoring the camera's transform.
  function pageRect(el: HTMLElement): Box {
    let x = 0;
    let y = 0;
    let n: HTMLElement | null = el;
    while (n && n !== page) {
      x += n.offsetLeft;
      y += n.offsetTop;
      n = n.offsetParent as HTMLElement | null;
    }
    return { x, y, w: el.offsetWidth, h: el.offsetHeight };
  }

  function stage(): Box {
    // The bar wraps to two rows on a phone, so measure it rather than assume.
    const bar = q<HTMLElement>('.rm-bar').offsetHeight || BAR;
    if (wide()) {
      const panel = Math.min(464, innerWidth * 0.36);
      return { x: 40, y: bar + 40, w: innerWidth - panel - 48 - 40 - 56, h: innerHeight - bar - 80 };
    }
    const sheet = Math.round(innerHeight * 0.5);
    return { x: 16, y: bar + 30, w: innerWidth - 32, h: innerHeight - sheet - bar - 48 };
  }

  function fit(r: Box, box: Box, max: number): Box & { s: number } {
    const s = Math.min(box.w / r.w, box.h / r.h, max);
    return { s, x: box.x + (box.w - r.w * s) / 2, y: box.y + (box.h - r.h * s) / 2, w: r.w * s, h: r.h * s };
  }

  function union(a: Box, b: Box): Box {
    const x = Math.min(a.x, b.x);
    const y = Math.min(a.y, b.y);
    return { x, y, w: Math.max(a.x + a.w, b.x + b.w) - x, h: Math.max(a.y + a.h, b.y + b.h) - y };
  }

  function setCamera(s: number, tx: number, ty: number) {
    page.style.transform = `translate(${tx}px, ${ty}px) scale(${s})`;
  }

  function place(el: HTMLElement, b: Box) {
    el.style.left = `${b.x}px`;
    el.style.top = `${b.y}px`;
    el.style.width = `${b.w}px`;
    el.style.height = `${b.h}px`;
  }

  function frame() {
    if (view === 'card') {
      const s = 0.985;
      setCamera(s, (innerWidth * (1 - s)) / 2, innerHeight / 2 - s * (saved + innerHeight / 2));
      const r = card.getBoundingClientRect();
      place(spot, { x: r.left, y: r.top, w: r.width, h: r.height });
      const shift = wide() ? 18 : 12;
      place(offset, { x: r.left + shift, y: r.top + shift, w: r.width, h: r.height });
      return;
    }

    const plates = [...table.querySelectorAll<HTMLElement>('.rm-plate')];
    const target = view === 'end' ? union(pageRect(plates[0]), pageRect(plates[plates.length - 1])) : pageRect(plateOf(view));
    const shown = fit(target, stage(), 1);
    setCamera(shown.s, shown.x - shown.s * target.x, shown.y - shown.s * target.y);

    const pad = wide() ? 14 : 8;
    place(spot, { x: shown.x - pad, y: shown.y - pad, w: shown.w + pad * 2, h: shown.h + pad * 2 });
    place(zoomHit, { x: shown.x - pad, y: shown.y - pad, w: shown.w + pad * 2, h: shown.h + pad * 2 });
    const slugText = stopTemplates.get(view)?.dataset.slug ?? '';
    slug.textContent = slugText;
    slug.hidden = !slugText;
    slug.style.left = `${shown.x - pad}px`;
    slug.style.top = `${wide() ? shown.y - pad - 26 : shown.y - pad - 22}px`;
  }

  function renderPanel() {
    if (view === 'end') {
      panelBody.replaceChildren(endTemplate.content.cloneNode(true));
      panelBody.querySelector<HTMLButtonElement>('[data-end-card]')!.onclick = () => go('card');
      panelBody.querySelector<HTMLButtonElement>('[data-end-exit]')!.onclick = close;
      stepNav.hidden = true;
      return;
    }
    panelBody.replaceChildren(stopTemplates.get(view)!.content.cloneNode(true));
    const chapter = chapterOf(view)!;
    const at = chapter.stops.indexOf(view);
    stepCount.textContent = chapter.stops.length > 1 ? `${at + 1} of ${chapter.stops.length}` : chapter.name;
    const after = ORDER[ORDER.indexOf(view) + 1];
    next.textContent = `${after === 'end' ? 'Wrap up' : labelOf(after)} →`;
    stepNav.hidden = false;
  }

  // The dropdown moves between projects; the timeline shows the current project's stops.
  function renderBar() {
    const at = ORDER.indexOf(view);
    const current = chapterOf(view);
    const count = current && current.stops.length > 1 ? `<span>${current.stops.indexOf(view) + 1} of ${current.stops.length}</span>` : '';
    projectBtn.innerHTML = `${current ? current.name : 'Projects'}${count}<i aria-hidden="true">▾</i>`;
    projectBtn.setAttribute('aria-expanded', String(menuOpen));

    menu.hidden = !menuOpen;
    menu.replaceChildren(
      ...CHAPTERS.map((c) => {
        const item = document.createElement('button');
        item.type = 'button';
        item.setAttribute('role', 'menuitem');
        const last = ORDER.indexOf(c.stops[c.stops.length - 1]);
        item.dataset.state = c === current ? 'now' : last < at ? 'past' : 'next';
        const stops = c.key === 'contact' ? '' : c.stops.length > 1 ? `${c.stops.length} stops` : '1 stop';
        item.innerHTML = `<strong>${c.name}</strong><span>${[c.years, stops].filter(Boolean).join(' · ')}</span>`;
        item.onclick = () => {
          menuOpen = false;
          if (c === current) renderBar();
          else go(c.stops[0]);
        };
        return item;
      }),
    );

    stopsNav.replaceChildren(
      ...(current ? current.stops : []).map((id) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'rm-seg';
        const i = ORDER.indexOf(id);
        b.dataset.state = i === at ? 'now' : i < at ? 'past' : 'next';
        if (i === at) b.setAttribute('aria-current', 'step');
        b.innerHTML = `<span></span><em>${labelOf(id)}</em>`;
        b.onclick = () => go(id);
        return b;
      }),
    );
    stopsNav.style.setProperty('--n', String(current ? current.stops.length : 1));
  }

  function show() {
    closeZoom();
    root.dataset.view = view === 'card' ? 'card' : 'tour';
    root.dataset.end = view === 'end' ? 'true' : 'false';
    card.hidden = view !== 'card';
    card.classList.remove('rm-card-out');
    menuOpen = false;
    if (view !== 'card') renderPanel();
    renderBar();
    frame();
    const focus = view === 'card' ? card.querySelector<HTMLElement>('.rm-name') : panelBody.querySelector<HTMLElement>('.rm-title');
    focus?.focus({ preventScroll: true });
  }

  function go(id: string) {
    if (busy || id === view) return;
    if (view === 'card' && !reduced.matches) {
      busy = true;
      card.classList.add('rm-card-out');
      setTimeout(() => {
        busy = false;
        view = id;
        show();
      }, 200);
      return;
    }
    view = id;
    show();
  }

  function open(first: string) {
    if (root.hidden) {
      opener = document.activeElement as HTMLElement | null;
      saved = scrollY;
      page.classList.add('rm-page');
      page.style.transition = 'none';
      setCamera(1, 0, -saved);
      document.documentElement.classList.add('rm-open');
      page.inert = true;
      root.hidden = false;
      void page.offsetWidth;
      page.style.transition = '';
      toggle?.setAttribute('aria-pressed', 'true');
    }
    view = '';
    // A timer, not an animation frame: a link opened in a background tab still starts.
    setTimeout(() => {
      root.classList.add('rm-on');
      go(first);
    }, 20);
  }

  function close() {
    if (root.hidden) return;
    closeZoom();
    root.classList.remove('rm-on');
    setCamera(1, 0, -saved);
    toggle?.setAttribute('aria-pressed', 'false');
    setTimeout(() => {
      root.hidden = true;
      root.dataset.view = '';
      page.style.transition = 'none';
      page.classList.remove('rm-page');
      page.style.transform = '';
      document.documentElement.classList.remove('rm-open');
      page.inert = false;
      scrollTo({ top: saved, behavior: 'instant' });
      void page.offsetWidth;
      page.style.transition = '';
      view = '';
      opener?.focus({ preventScroll: true });
    }, duration());
  }

  // On a phone the plate is shrunk to fit; this shows a copy at full size in a
  // plain scrolling layer, so panning is ordinary scrolling.
  function openZoom() {
    if (view === 'card' || view === 'end') return;
    zoomBody.replaceChildren(plateOf(view).cloneNode(true));
    zoom.hidden = false;
    zoom.scrollTo(0, 0);
    q<HTMLButtonElement>('.rm-zoom-close').focus({ preventScroll: true });
  }
  function closeZoom() {
    if (zoom.hidden) return;
    zoom.hidden = true;
    zoomBody.replaceChildren();
    zoomHit.focus({ preventScroll: true });
  }
  zoomHit.onclick = openZoom;
  q<HTMLButtonElement>('.rm-zoom-close').onclick = closeZoom;

  back.onclick = () => go(ORDER[ORDER.indexOf(view) - 1]);
  next.onclick = () => go(ORDER[ORDER.indexOf(view) + 1]);
  q<HTMLButtonElement>('.rm-exit').onclick = close;
  q<HTMLButtonElement>('[data-rm-tour]').onclick = () => go(ORDER[1]);
  q<HTMLButtonElement>('[data-rm-card]').onclick = () => go('card');
  toggle?.addEventListener('click', () => (root.hidden ? open('card') : close()));

  projectBtn.onclick = (e) => {
    e.stopPropagation();
    menuOpen = !menuOpen;
    renderBar();
  };
  root.addEventListener('click', () => {
    if (menuOpen) {
      menuOpen = false;
      renderBar();
    }
  });

  addEventListener('keydown', (e) => {
    if (root.hidden) return;
    if (!zoom.hidden) {
      if (e.key === 'Escape') closeZoom();
      return;
    }
    if (e.key === 'Escape') {
      if (menuOpen) {
        menuOpen = false;
        renderBar();
      } else close();
    } else if (e.key === 'ArrowRight' && view !== 'card' && view !== 'end') next.click();
    else if (e.key === 'ArrowLeft' && view !== 'card') back.click();
  });

  let resizing = 0;
  addEventListener('resize', () => {
    if (root.hidden) return;
    clearTimeout(resizing);
    resizing = window.setTimeout(() => {
      page.style.transition = 'none';
      frame();
      void page.offsetWidth;
      page.style.transition = '';
    }, 30);
  });

  // ?resume opens the card; ?chapter=<key> starts at that chapter's first stop.
  const params = new URLSearchParams(location.search);
  const chapterParam = CHAPTERS.find((c) => c.key === params.get('chapter'));
  if (chapterParam) open(chapterParam.stops[0]);
  else if (params.has('resume') || location.hash === '#resume') open('card');
</script>

<style is:global>
  #page { position: relative; }
  #page.rm-page {
    position: fixed;
    inset: 0 0 auto 0;
    transform-origin: 0 0;
    transition: transform 1050ms cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }
  html.rm-open, html.rm-open body { overflow: hidden; }

  .rm { position: fixed; inset: 0; z-index: 50; pointer-events: none; }
  .rm[hidden] { display: none; }
  .rm button, .rm a, .rm-panel, .rm-card, .rm-bar { pointer-events: auto; }
  .rm button { color: inherit; }

  .rm-scrim {
    position: fixed;
    inset: 0;
    background-color: rgba(236, 235, 229, 0.88);
    background-image: radial-gradient(rgba(181, 175, 163, 0.7) 1.1px, transparent 1.3px);
    background-size: 18px 18px;
    opacity: 0;
    transition: opacity 420ms ease;
  }
  .rm.rm-on[data-view='card'] .rm-scrim { opacity: 1; }

  .rm-spot {
    position: fixed;
    box-sizing: border-box;
    border: 1.5px solid var(--ink);
    box-shadow: 0 0 0 3000px rgba(236, 235, 229, 0);
    opacity: 0;
    transition:
      left 1050ms cubic-bezier(0.65, 0, 0.35, 1),
      top 1050ms cubic-bezier(0.65, 0, 0.35, 1),
      width 1050ms cubic-bezier(0.65, 0, 0.35, 1),
      height 1050ms cubic-bezier(0.65, 0, 0.35, 1),
      box-shadow 600ms ease,
      background-color 360ms ease,
      opacity 360ms ease;
  }
  .rm.rm-on .rm-spot { opacity: 1; }
  .rm.rm-on[data-view='card'] .rm-spot { background: var(--paper-lit); }
  .rm.rm-on[data-view='tour'] .rm-spot { box-shadow: 0 0 0 3000px rgba(236, 235, 229, 0.9); }

  .rm-offset {
    position: fixed;
    background: var(--sunflower);
    opacity: 0;
    transform: translate(-18px, -18px);
    transition: transform 460ms cubic-bezier(0.2, 0.7, 0.1, 1) 220ms, opacity 200ms ease 160ms;
  }
  .rm.rm-on[data-view='card'] .rm-offset { opacity: 1; transform: none; }

  .rm-slug {
    position: fixed;
    height: 26px;
    display: flex;
    align-items: center;
    padding: 0 10px;
    background: var(--ink);
    color: var(--paper-lit);
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
    opacity: 0;
    transition: left 1050ms cubic-bezier(0.65, 0, 0.35, 1), top 1050ms cubic-bezier(0.65, 0, 0.35, 1), opacity 260ms ease;
  }
  .rm.rm-on[data-view='tour'] .rm-slug:not([hidden]) { opacity: 1; }
  .rm-slug[hidden] { display: flex; opacity: 0 !important; }

  @keyframes rm-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .rm .rise { animation: rm-rise 560ms cubic-bezier(0.2, 0.7, 0.1, 1) both; animation-delay: var(--d, 0ms); }

  /* ---------- business card ---------- */
  .rm-card {
    position: fixed;
    left: 50%;
    top: calc(32px + 50vh);
    transform: translate(-50%, -50%);
    width: min(640px, calc(100vw - 32px));
    max-height: calc(100vh - 88px);
    overflow-y: auto;
    box-sizing: border-box;
    padding: 40px 44px;
    transition: opacity 220ms ease, transform 220ms ease;
  }
  .rm-card[hidden] { display: none; }
  .rm-card.rm-card-out { opacity: 0; transform: translate(-50%, calc(-50% - 6px)); }
  .rm-card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .rm-name { font-family: var(--font-display); font-weight: 600; font-size: 44px; line-height: 1; letter-spacing: -0.02em; outline: none; }
  .rm-role { font-family: var(--font-display); font-size: 19px; line-height: 1.3; color: var(--grape); margin-top: 10px; }
  .rm-card-mark { width: 44px; height: 44px; flex: none; }
  .rm-rule { height: 1px; background: var(--rule); margin: 24px 0 20px; }
  .rm-history { display: flex; flex-direction: column; gap: 11px; }
  .rm-history div { display: grid; grid-template-columns: 80px minmax(0, 1fr); column-gap: 16px; align-items: baseline; }
  .rm-history dt { font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); }
  .rm-history dd { margin: 0; font-size: 16px; line-height: 1.45; color: var(--ink); }
  .rm-card-actions { margin-top: 28px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .rm-email { margin-left: auto; font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); }

  /* ---------- buttons ---------- */
  .rm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 46px;
    padding: 0 20px;
    border: 0;
    background: var(--ink);
    color: var(--paper-lit) !important;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 160ms ease-out, border-color 160ms ease-out;
  }
  .rm-btn:active { transform: translateY(1px); }
  @media (hover: hover) { .rm-btn:hover { background: var(--grape); } }
  .rm-btn-ghost { background: transparent; color: var(--ink) !important; border: 1.5px solid var(--rule-firm); }
  @media (hover: hover) { .rm-btn-ghost:hover { background: var(--paper-lit); border-color: var(--ink); } }
  .rm-btn-block { width: 100%; }
  .rm :focus-visible { outline: 2px solid var(--grape); outline-offset: 3px; }
  .rm-title:focus, .rm-name:focus { outline: none; }

  /* ---------- panel ---------- */
  .rm-panel-wrap {
    position: fixed;
    top: 64px;
    bottom: 0;
    right: 48px;
    width: min(464px, 36vw);
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .rm-panel {
    position: relative;
    width: 100%;
    opacity: 0;
    transform: translateX(56px);
    transition: transform 640ms cubic-bezier(0.2, 0.7, 0.1, 1) 470ms, opacity 420ms ease 470ms;
    pointer-events: none;
  }
  .rm.rm-on[data-view='tour'] .rm-panel { opacity: 1; transform: none; pointer-events: auto; }
  .rm-panel-ink { position: absolute; inset: 0; transform: translate(14px, 14px); background: var(--sunflower); }
  .rm-panel-box {
    position: relative;
    box-sizing: border-box;
    height: min(768px, calc(100vh - 112px));
    display: flex;
    flex-direction: column;
    background: var(--paper-lit);
    border: 1.5px solid var(--ink);
  }
  @media (min-width: 1000px) { .rm[data-end='true'] .rm-panel-box { height: auto; } }
  .rm-panel-body { flex: 1 1 auto; overflow-y: auto; padding: 30px 32px 16px; display: flex; flex-direction: column; gap: 16px; }
  .rm-meta-line { font-family: var(--font-mono); font-size: 12px; color: var(--grape); }
  .rm-title { font-family: var(--font-display); font-weight: 600; font-size: 30px; line-height: 1.1; outline: none; text-wrap: balance; }
  .rm-lede { font-size: 16px; line-height: 1.5; color: var(--ink-muted); }
  .rm-text { font-size: 16px; line-height: 1.5; color: var(--ink); }
  .rm-meta { font-family: var(--font-mono); font-size: 12px; line-height: 1.5; color: var(--ink-muted); }
  .rm-step-nav { display: flex; align-items: center; gap: 10px; padding: 14px 32px 24px; border-top: 1px solid var(--rule); }
  .rm-step-nav[hidden] { display: none; }
  .rm-back { min-width: 46px; padding: 0; font-size: 18px; }
  .rm-step-count { font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); }
  .rm-next { margin-left: auto; }

  .rm-flow { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .rm-flow li {
    position: relative;
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 10px 14px;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    font-size: 14px;
    line-height: 1.35;
  }
  .rm-flow li + li { margin-top: 12px; }
  .rm-flow li + li::before { content: ''; position: absolute; left: 22px; top: -13.5px; width: 1.5px; height: 12px; background: var(--ink); }
  .rm-flow li span { font-family: var(--font-mono); font-size: 12px; color: var(--grape); }

  .rm-links { list-style: none; padding: 0; margin: 0; }
  .rm-links li { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--rule); }
  .rm-links li:last-child { border-bottom: 1px solid var(--rule); }
  .rm-links li > span { display: flex; flex-direction: column; font-size: 15px; line-height: 1.4; color: var(--ink-muted); }
  .rm-links strong { font-family: var(--font-display); font-weight: 600; font-size: 16px; color: var(--ink); }
  .rm-links a { display: inline-flex; align-items: center; min-height: 44px; white-space: nowrap; font-size: 15px; }
  .rm-end-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }

  /* ---------- the bar: one timeline per chapter ---------- */
  .rm-bar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 64px;
    box-sizing: border-box;
    padding: 0 48px;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    background: var(--paper);
    border-bottom: 1.5px solid var(--ink);
    transform: translateY(-100%);
    transition: transform 560ms cubic-bezier(0.2, 0.7, 0.1, 1);
  }
