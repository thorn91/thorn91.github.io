---
import '../styles/tokens.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const email = 'tom@prettygoodsoftware.llc';
const resume = `${base}thomas-horn-resume.pdf`;

const now = [
  "At Buyers Edge Platform, I'm working on our accounting system and on making the product work for restaurant groups that run many brands and locations.",
  "I'm building agentom, a set of tools for coding with AI agents. It asks the engineer to explain a change before it ships.",
];

const elsewhere = [
  { name: 'Pretty Good Software', href: 'https://prettygoodsoftware.llc', mark: 'brand/pgs-mark.svg' },
  { name: 'Pretty Good Video Coaching', href: 'https://coaching.prettygoodsoftware.llc', mark: 'brand/pgvc-mark.svg' },
  { name: 'GitHub', href: 'https://github.com/thorn91' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/thomaswarrenhorn/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thomas Horn</title>
    <meta
      name="description"
      content="Thomas Horn, a software engineer in Raleigh, North Carolina. I lead a team working on core accounting and operations software for restaurants, and make small apps through Pretty Good Software."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}brand/th-mark.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;600&family=Petrona:wght@400;500&family=Azeret+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="page">
      <header class="head">
        <a class="wordmark" href="#top">
          <!-- The PGS mark with this site's ink: grape at (40,60), sunflower
               at (60,40), the lens drawn explicitly in the overprint colour
               so it renders the same everywhere. -->
          <svg width="24" height="24" viewBox="0 0 100 100" aria-hidden="true">
            <clipPath id="lens"><circle cx="40" cy="60" r="30" /></clipPath>
            <circle cx="40" cy="60" r="30" fill="#4b3a8c" />
            <circle cx="60" cy="40" r="30" fill="#ffb511" />
            <circle cx="60" cy="40" r="30" fill="#4b2909" clip-path="url(#lens)" />
          </svg>
          Thomas Horn
        </a>
        <nav class="nav">
          <a href="#now">Now</a>
          <a href="#elsewhere">Elsewhere</a>
          <a href={resume}>Resume</a>
        </nav>
      </header>

      <main>
        <section id="top" class="intro">
          <div>
            <h1>Thomas Horn</h1>
            <p class="role">Software engineer in Raleigh, North Carolina</p>
            <p class="lede">
              I lead an engineering team at Buyers Edge Platform, where we work on core
              accounting and operations software for restaurants. I also make small apps
              through my own company, <a href="https://prettygoodsoftware.llc">Pretty Good Software</a>.
            </p>
            <p class="links">
              <a href={resume}>Resume</a>
              <a href={`mailto:${email}`}>{email}</a>
            </p>
          </div>
          <!-- Two inks overprinting: real multiply over the paper, which is
               what riso inks do where they overlap. -->
          <div class="art" aria-hidden="true">
            <div class="ink ink-sunflower"></div>
            <div class="ink ink-grape"></div>
          </div>
        </section>

        <section id="now" class="split">
          <div>
            <h2>Now</h2>
            <p class="meta">Updated October 2026</p>
          </div>
          <ul class="now">
            <li>{now[0]}</li>
            <li>
              <a href="https://coaching.prettygoodsoftware.llc">Pretty Good Video Coaching</a>,
              my iPhone app for physical therapists, is in TestFlight beta. I'm working
              through feedback from the therapists testing it.
            </li>
            <li>
              I'm a part-time technical advisor to
              <a href="https://www.collectiviq.ai/">CollectivIQ</a>, where I helped build
              the first version.
            </li>
            {now.slice(1).map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="split">
          <div>
            <h2>About</h2>
            <p class="muted">
              I studied neuroscience at Rhodes College, then computer science at the
              University of Georgia. I got into programming to automate tedious work, and
              that's still what I enjoy most. I've taught high school computer science
              through Microsoft TEALS and volunteer with ChickTech.
            </p>
            <p class="muted">
              Email is the best way to reach me: <a href={`mailto:${email}`}>{email}</a>.
            </p>
          </div>
          <div id="elsewhere">
            <h2>Elsewhere</h2>
            <ul class="elsewhere">
              {
                elsewhere.map((link) => (
                  <li>
                    <a href={link.href}>
                      {link.mark && <img src={`${base}${link.mark}`} width="20" height="20" alt="" />}
                      {link.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>
      </main>

      <footer class="foot">
        <span>Thomas Horn · Raleigh, NC</span>
        <a href={`mailto:${email}`}>{email}</a>
      </footer>
    </div>

    <style is:global>
      *,
      *::before,
      *::after { box-sizing: border-box; }
      * { margin: 0; }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 18px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      img { display: block; max-width: 100%; height: auto; }

      /* Tailwind's preflight (loaded site-wide for the older pages) strips
         link underlines, so set them back explicitly. */
      a {
        color: var(--ink);
        text-decoration-line: underline;
        text-decoration-color: var(--rule);
        text-underline-offset: 3px;
      }
      a:hover { color: var(--grape); text-decoration-color: var(--grape); }
      a:focus-visible { outline: 2px solid var(--grape); outline-offset: 3px; }

      h1, h2, .wordmark, .nav, .role {
        font-family: var(--font-display);
      }
      h1, h2 { font-weight: 600; text-wrap: balance; }

      .page {
        max-width: var(--content-max);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      /* ---------- header ---------- */
      .head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 4px 24px;
        padding-block: 18px;
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: var(--tap);
        font-weight: 600;
        font-size: 18px;
        text-decoration-line: none;
      }
      .nav { display: flex; flex-wrap: wrap; gap: 0 24px; font-size: 16px; }
      .nav a {
        display: inline-flex;
        align-items: center;
        min-height: var(--tap);
        color: var(--ink-muted);
        text-decoration: none;
      }
      .nav a:hover { color: var(--grape); }

      /* ---------- sections ---------- */
      main > section { border-top: 1px solid var(--rule); }

      .intro {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
        padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 7vw, 5.5rem);
      }
      h1 {
        font-size: clamp(2.8rem, 6vw, 4.5rem);
        line-height: 1;
        letter-spacing: -0.02em;
      }
      .role {
        margin-top: 14px;
        font-size: clamp(1.25rem, 2.2vw, 1.5rem);
        line-height: 1.3;
        color: var(--grape);
      }
      .lede { margin-top: 24px; max-width: 46ch; color: var(--ink-muted); }
      .links { display: flex; flex-wrap: wrap; gap: 0 20px; margin-top: 24px; }
      .links a,
      .elsewhere a {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: var(--tap);
      }

      .art { position: relative; height: 300px; }
      .ink {
        position: absolute;
        border-radius: 50%;
        mix-blend-mode: multiply;
      }
      .ink-sunflower { width: 220px; height: 220px; top: 0; right: 8%; background: var(--sunflower); }
      .ink-grape { width: 190px; height: 190px; top: 96px; right: 36%; background: var(--grape); }

      .split {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: clamp(1.75rem, 4vw, 3rem);
        padding-block: clamp(3rem, 6vw, 5rem);
      }
      h2 { font-size: clamp(1.8rem, 3.2vw, 2.4rem); line-height: 1.1; }
      .meta {
        margin-top: 10px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--ink-muted);
      }
      .muted { margin-top: 18px; max-width: 46ch; color: var(--ink-muted); }
      .muted + .muted { margin-top: 14px; }

      .now { list-style: none; padding: 0; max-width: 60ch; }
      .now li {
        padding-block: 14px;
        border-top: 1px solid var(--rule);
        color: var(--ink-muted);
      }
      .elsewhere { list-style: none; padding: 0; margin-top: 18px; }

      /* ---------- footer ---------- */
      .foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0 24px;
        padding-block: 20px 32px;
        border-top: 1px solid var(--rule);
        font-size: 15px;
        color: var(--ink-muted);
      }
      .foot a {
        display: inline-flex;
        align-items: center;
        min-height: var(--tap);
        color: var(--ink-muted);
      }

      /* The art column is decoration; on a phone it would push the content
         below the fold, so it goes. */
      @media (max-width: 700px) {
        .art { display: none; }
      }
    </style>
  </body>
</html>
