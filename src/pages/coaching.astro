---
import Layout from '../layouts/Layout.astro';

const TESTFLIGHT = 'https://testflight.apple.com/join/D4kfw9zp';

const steps = [
  {
    n: '01',
    title: 'Capture or import',
    body: 'Record in-app or pull a clip from Photos. Your copy lives on the device.',
  },
  {
    n: '02',
    title: 'Talk it through',
    body:
      'Hit record and work the clip the way you would explain it out loud — scrub back, zoom in, draw on the joint.',
  },
  {
    n: '03',
    title: 'Hand it over',
    body:
      'Play the analysis back, share the marked-up clip, or export a PDF of the moments that matter.',
  },
];

const capabilities = [
  {
    title: 'Record the whole analysis',
    body:
      'Your voice, where you scrub, what you zoom into, and every mark as you make it. Hit Play Analysis to watch it back.',
    icon: 'record',
  },
  {
    title: 'Angles that read out degrees',
    body:
      'Set an angle on the joint or drag a measured line. Nothing snaps to a rounder number — the reading is where you put it.',
    icon: 'angle',
  },
  {
    title: 'True frame-by-frame',
    body:
      'Shoot up to 240 fps, play at 1×, ½× or ¼×, and step a frame at a time on the tick strip.',
    icon: 'frame',
  },
  {
    title: 'Build a PDF report',
    body:
      'Mark the moments that matter, write what to notice under each, and export a PDF — stills re-rendered at print resolution.',
    icon: 'report',
  },
  {
    title: 'Trim without destroying',
    body:
      'Cut the settling-in and the slow-down. Nothing is deleted — any cut can be restored later.',
    icon: 'trim',
  },
  {
    title: 'Send a flat video',
    body:
      'Export the analysis as a plain video — your narration, marks and zoom baked in. No app required to watch it.',
    icon: 'share',
  },
];

// Small line icons, stroked with currentColor so they inherit the accent.
const ICONS: Record<string, string> = {
  record: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5" fill="currentColor"/>',
  angle: '<path d="M4 20 L20 20"/><path d="M4 20 L16.5 5.5"/><path d="M11 20 a7 7 0 0 0 -2.6 -5.4"/>',
  frame: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M9.5 10 l-2.2 2 2.2 2"/><path d="M14.5 10 l2.2 2 -2.2 2"/>',
  report: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8 h6"/><path d="M8 12 h8"/><path d="M8 16 h5"/>',
  trim: '<circle cx="6" cy="7" r="2.5"/><circle cx="6" cy="17" r="2.5"/><path d="M8 8.5 L19 16.5"/><path d="M8 15.5 L19 7.5"/>',
  share: '<path d="M12 15 V4"/><path d="M8 8 l4 -4 4 4"/><path d="M5 12 v6 a1 1 0 0 0 1 1 h12 a1 1 0 0 0 1 -1 v-6"/>',
};
const icon = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICONS[name] ?? ''}</svg>`;
---

<Layout title="Pretty Good Video Coaching — movement analysis for PTs">
  <Fragment slot="head">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Frame-accurate movement analysis for clinicians. Measure joint angles, mark up the fix, and send clients a clip they'll understand — all on your iPhone. Now in TestFlight beta."
    />

    <!-- Link previews (iMessage, Slack, etc). Without these a scraper grabs the
         first big image on the page, which is a client's footage — the app icon
         is the right face for a shared link. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pretty Good Video Coaching" />
    <meta property="og:title" content="Pretty Good Video Coaching" />
    <meta
      property="og:description"
      content="Frame-accurate movement analysis for clinicians. Now in TestFlight beta."
    />
    <meta property="og:url" content="https://thomashorn.info/coaching/" />
    <meta property="og:image" content="https://thomashorn.info/coaching/icon.jpg" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Pretty Good Video Coaching app icon" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Pretty Good Video Coaching" />
    <meta
      name="twitter:description"
      content="Frame-accurate movement analysis for clinicians. Now in TestFlight beta."
    />
    <meta name="twitter:image" content="https://thomashorn.info/coaching/icon.jpg" />
    <link rel="apple-touch-icon" href="/coaching/icon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="pg">
    <!-- ============ HERO ============ -->
    <section class="pg-hero">
      <div class="pg-hero-inner">
        <div class="pg-hero-copy">
          <p class="pg-eyebrow">TestFlight beta · iPhone · iOS&nbsp;17+</p>
          <h1 class="pg-h1">Pretty Good<br />Video Coaching</h1>
          <p class="pg-lede">Frame-accurate movement analysis for clinicians.</p>
          <p class="pg-sub">
            Capture a client's movement, then record the whole analysis — your voice,
            the frame you scrubbed back to, the angle you drew on the joint. They get
            the explanation, not just the clip.
          </p>
          <div class="pg-cta-row">
            <a class="pg-btn" href={TESTFLIGHT} target="_blank" rel="noopener">
              Join the beta
            </a>
            <a class="pg-btn-ghost" href="#install">Scan to install&nbsp;↓</a>
          </div>
        </div>

        <!-- Real app screenshot: the player measuring a knee, frame by frame -->
        <div class="pg-device">
          <div class="pg-phone">
            <img
              src="/coaching/player.jpg"
              width="720"
              height="1565"
              alt="The player paused on frame 410 of a squat, with a measured line along the barbell reading 1 degree off level."
            />
          </div>
          <span class="pg-device-cap">Frame 410 / 627 · bar 1° off level</span>
        </div>
      </div>
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section class="pg-steps">
      <p class="pg-eyebrow pg-eyebrow-c">The session, end to end</p>
      <div class="pg-steps-grid">
        {steps.map((s, i) => (
          <div class="pg-step">
            <span class="pg-step-n">{s.n}</span>
            <h3 class="pg-step-t">{s.title}</h3>
            <p class="pg-step-b">{s.body}</p>
            {i < steps.length - 1 && <span class="pg-step-arrow" aria-hidden="true">→</span>}
          </div>
        ))}
      </div>
    </section>

    <!-- ============ CAPABILITIES ============ -->
    <section class="pg-caps">
      <div class="pg-caps-head">
        <p class="pg-eyebrow">Built around the measurement</p>
        <h2 class="pg-h2">The tools a movement assessment actually needs.</h2>
      </div>
      <div class="pg-caps-grid">
        {capabilities.map((c) => (
          <article class="pg-cap">
            <span class="pg-cap-ico" set:html={icon(c.icon)} />
            <h3 class="pg-cap-t">{c.title}</h3>
            <p class="pg-cap-b">{c.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ============ REAL SCREENS ============ -->
    <section class="pg-screens">
      <div class="pg-screens-head">
        <p class="pg-eyebrow">On your iPhone</p>
        <h2 class="pg-h2">Every clip, filed under the right client.</h2>
        <p class="pg-screens-sub">
          Shoot into a client from the camera, or drop clips in Unassigned and sort
          them later. No folders to manage, no accounts to set up.
        </p>
      </div>
      <div class="pg-screens-row">
        <figure class="pg-shot">
          <div class="pg-phone"><img src="/coaching/recent.jpg" width="640" height="1391" alt="The Recent tab listing saved clips with their thumbnails." /></div>
          <figcaption>Recent — pick up where you left off</figcaption>
        </figure>
        <figure class="pg-shot">
          <div class="pg-phone"><img src="/coaching/clients.jpg" width="640" height="1391" alt="The Clients tab with an Unassigned inbox and a list of clients by injury area." /></div>
          <figcaption>Clients — organized by who and what</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ THE REPORT ============ -->
    <section class="pg-report">
      <div class="pg-report-inner">
        <div class="pg-report-copy">
          <p class="pg-eyebrow">The thing you hand over</p>
          <h2 class="pg-h2">A PDF they can read without the app.</h2>
          <p class="pg-report-sub">
            Step to a frame, tap <strong>+</strong>, and write what they should
            notice. The report prints each moment with its timecode, your note, and
            the still — re-rendered at print resolution with your marks drawn back
            in as vectors, not a screenshot of your phone.
          </p>
          <ul class="pg-reqs pg-reqs-dark">
            <li>US Letter PDF · shares anywhere</li>
            <li>Drawings re-rendered, not screenshotted</li>
            <li>Toggle any moment out before you send</li>
          </ul>
        </div>
        <figure class="pg-page">
          <img src="/coaching/report.jpg" width="880" height="1138" alt="A one-page PDF report titled Movement analysis, showing a squat still with a measured line reading 1 degree, its timecode, and a coaching note." />
          <figcaption>An actual page, exported from the app</figcaption>
        </figure>
      </div>
      <figure class="pg-builder">
        <div class="pg-phone"><img src="/coaching/builder.jpg" width="640" height="1391" alt="The Build report sheet listing two marked moments with thumbnails, timecodes, include switches and note text." /></div>
        <figcaption>Where you write it — moments, cues, and what makes the cut</figcaption>
      </figure>
    </section>

    <!-- ============ PRIVACY BAND ============ -->
    <section class="pg-priv">
      <p class="pg-eyebrow pg-eyebrow-c">Built for client privacy</p>
      <p class="pg-priv-line">
        No accounts. No cloud. No sign-in.<br />
        <span>Every clip, drawing, and voice note stays on your iPhone —
        nothing about your clients leaves the device.</span>
      </p>
    </section>

    <!-- ============ JOIN THE BETA ============ -->
    <section class="pg-install" id="install">
      <div class="pg-install-card">
        <div class="pg-install-copy">
          <p class="pg-eyebrow">Now testing</p>
          <h2 class="pg-h2 pg-h2-dark">Join the TestFlight beta</h2>
          <p class="pg-install-sub">
            Scan the code, install Apple TestFlight if you're asked, and the app is
            yours. Free for the duration of the beta.
          </p>
          <ul class="pg-reqs">
            <li>iPhone · iOS 17 or later</li>
            <li>Free during beta</li>
            <li>Feedback goes straight to the developer</li>
          </ul>
          <a class="pg-link" href={TESTFLIGHT} target="_blank" rel="noopener"
            >testflight.apple.com/join/D4kfw9zp</a
          >
        </div>
        <a class="pg-qr" href={TESTFLIGHT} target="_blank" rel="noopener" aria-label="Scan to join the TestFlight beta">
          <div class="pg-qr-svg">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 390 390"><g transform="scale(10)"><path fill="#fff" d="M0 0h39v39h-39z"/><path stroke="#0f172a" d="M3 3.5h7m4 0h1m1 0h1m1 0h1m3 0h2m2 0h1m2 0h7m-33 1h1m5 0h1m1 0h1m3 0h3m1 0h2m2 0h2m1 0h1m2 0h1m5 0h1m-33 1h1m1 0h3m1 0h1m1 0h3m1 0h3m1 0h1m1 0h2m3 0h2m1 0h1m1 0h3m1 0h1m-33 1h1m1 0h3m1 0h1m4 0h1m1 0h2m3 0h1m3 0h1m1 0h1m1 0h1m1 0h3m1 0h1m-33 1h1m1 0h3m1 0h1m2 0h1m1 0h5m1 0h2m2 0h1m2 0h1m1 0h1m1 0h3m1 0h1m-33 1h1m5 0h1m3 0h2m1 0h1m1 0h1m10 0h1m5 0h1m-33 1h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7m-23 1h1m3 0h4m1 0h1m3 0h2m-24 1h3m1 0h2m4 0h3m1 0h1m1 0h2m1 0h2m8 0h2m-29 1h1m5 0h1m7 0h5m1 0h1m2 0h2m1 0h2m1 0h1m-31 1h1m3 0h3m1 0h1m1 0h3m1 0h1m1 0h1m2 0h3m1 0h1m1 0h3m1 0h2m-32 1h1m2 0h1m3 0h2m4 0h4m1 0h1m2 0h1m1 0h1m1 0h2m1 0h1m1 0h2m-33 1h1m2 0h2m1 0h1m1 0h1m1 0h1m1 0h2m8 0h1m2 0h1m1 0h3m1 0h2m-32 1h1m9 0h3m2 0h2m2 0h3m4 0h1m1 0h1m1 0h1m-32 1h3m3 0h2m1 0h3m1 0h1m1 0h1m2 0h2m2 0h1m3 0h1m2 0h2m-30 1h5m1 0h1m2 0h3m1 0h5m2 0h2m2 0h6m-29 1h1m1 0h1m1 0h1m2 0h6m1 0h1m3 0h7m1 0h3m-27 1h2m1 0h1m1 0h2m2 0h1m1 0h2m1 0h1m1 0h1m1 0h3m1 0h1m1 0h2m1 0h2m-33 1h1m1 0h1m3 0h1m6 0h2m1 0h1m5 0h1m3 0h3m1 0h1m-30 1h5m1 0h2m10 0h1m2 0h1m2 0h2m1 0h1m2 0h2m-33 1h3m1 0h1m1 0h1m1 0h1m2 0h3m4 0h1m2 0h2m6 0h2m-31 1h2m3 0h1m1 0h1m1 0h2m10 0h2m3 0h1m2 0h1m2 0h1m-30 1h5m4 0h2m4 0h1m1 0h9m1 0h3m-32 1h1m2 0h2m2 0h1m2 0h1m3 0h2m1 0h2m3 0h3m1 0h1m1 0h1m1 0h2m-33 1h1m2 0h1m2 0h3m3 0h2m3 0h1m4 0h7m3 0h1m-25 1h4m3 0h3m1 0h3m2 0h1m3 0h2m-30 1h7m3 0h2m1 0h4m1 0h2m2 0h3m1 0h1m1 0h1m-29 1h1m5 0h1m1 0h1m2 0h3m1 0h1m2 0h1m1 0h5m3 0h3m-31 1h1m1 0h3m1 0h1m4 0h3m1 0h1m1 0h2m2 0h8m1 0h2m-32 1h1m1 0h3m1 0h1m1 0h1m1 0h2m2 0h1m1 0h1m3 0h2m1 0h1m3 0h1m1 0h4m-33 1h1m1 0h3m1 0h1m1 0h1m1 0h2m2 0h4m3 0h1m1 0h2m1 0h2m1 0h2m-31 1h1m5 0h1m1 0h3m1 0h1m2 0h2m1 0h3m2 0h3m1 0h3m2 0h1m-33 1h7m4 0h5m1 0h1m2 0h2m3 0h2m1 0h1m1 0h1"/></g></svg>
          </div>
          <span class="pg-qr-cap">Point your camera here</span>
        </a>
      </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="pg-foot">
      <p>Pretty Good Video Coaching — a focused tool for physical therapists, in beta.</p>
      <p>Built by <a href="mailto:thomas@thomashorn.info">Thomas Horn</a></p>
    </footer>
  </main>
</Layout>

<style>
  /* ---- tokens ---- */
  .pg {
    --ink: #0a1017;
    --ink-2: #0e1620;
    --paper: #edf1f2;
    --paper-2: #ffffff;
    --teal: #12b5ac;
    --amber: #f0a83c;
    --on-dark: #f3f6f8;
    --on-dark-mut: #9fb0bc;
    --on-light: #0a1017;
    --on-light-mut: #4a5a66;
    --hair-dark: #1d2a34;
    --hair-light: #d5dde1;

    --display: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    --body: 'Inter', ui-sans-serif, system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', monospace;

    font-family: var(--body);
    color: var(--on-dark);
    background: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  .pg * { box-sizing: border-box; }

  /* ---- shared type ---- */
  .pg-eyebrow {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal);
    margin: 0 0 1.1rem;
  }
  .pg-eyebrow-c { text-align: center; }
  .pg-h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.35rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .pg-h2 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
    margin: 0;
    max-width: 16ch;
  }
  .pg-h2-dark { color: var(--on-light); }

  /* ---- buttons ---- */
  .pg-cta-row { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.2rem; }
  .pg-btn {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1rem;
    background: var(--teal);
    color: #04110f;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 8px 30px -12px rgba(18, 181, 172, 0.7);
  }
  .pg-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 40px -12px rgba(18, 181, 172, 0.8); }
  .pg-btn-ghost {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--on-dark);
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    border: 1px solid #2a3945;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .pg-btn-ghost:hover { border-color: var(--teal); color: var(--teal); }

  /* ---- hero ---- */
  .pg-hero {
    background:
      radial-gradient(120% 80% at 85% 10%, rgba(18, 181, 172, 0.12), transparent 55%),
      var(--ink);
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.25rem, 5vw, 5rem) clamp(3rem, 6vw, 5.5rem);
  }
  .pg-hero-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .pg-lede {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.15rem, 2.1vw, 1.5rem);
    color: var(--teal);
    margin: 1.5rem 0 0;
  }
  .pg-sub {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--on-dark-mut);
    max-width: 42ch;
    margin: 1rem 0 0;
  }

  /* ---- device (real screenshots in a phone frame) ---- */
  .pg-device { display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .pg-phone {
    width: min(290px, 76vw);
    background: #05070a;
    padding: 8px;
    border-radius: 46px;
    box-shadow: 0 50px 90px -34px rgba(0, 0, 0, 0.65), inset 0 0 0 1px #232b33;
  }
  .pg-phone img { display: block; width: 100%; height: auto; border-radius: 38px; }
  .pg-device-cap {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--on-dark-mut);
  }
  .pg-rise { opacity: 0; transform: translateY(16px); animation: pg-rise 0.7s 0.1s ease-out forwards; }
  @keyframes pg-rise { to { opacity: 1; transform: none; } }

  /* ---- real screens showcase ---- */
  .pg-screens {
    background: var(--paper);
    color: var(--on-light);
    padding: clamp(3.5rem, 7vw, 6rem) clamp(1.25rem, 5vw, 5rem);
    border-top: 1px solid var(--hair-light);
  }
  .pg-screens .pg-eyebrow { color: #0c8e87; }
  .pg-screens-head { max-width: 640px; margin: 0 auto; text-align: center; }
  .pg-screens-head .pg-h2 { max-width: none; margin: 0 auto; }
  .pg-screens-sub { color: var(--on-light-mut); line-height: 1.6; margin: 1rem auto 0; max-width: 52ch; }
  .pg-screens-row {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-top: 3rem;
    flex-wrap: wrap;
  }
  .pg-shot { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .pg-shot .pg-phone { width: min(240px, 62vw); box-shadow: 0 30px 60px -34px rgba(10, 16, 23, 0.5), inset 0 0 0 1px #232b33; }
  .pg-shot figcaption {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--on-light-mut);
    text-align: center;
  }

  /* ---- steps ---- */
  .pg-steps {
    background: var(--ink-2);
    border-top: 1px solid var(--hair-dark);
    padding: clamp(3rem, 6vw, 5rem) clamp(1.25rem, 5vw, 5rem);
  }
  .pg-steps-grid {
    max-width: 1120px;
    margin: 1.5rem auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .pg-step { position: relative; }
  .pg-step-n {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--amber);
    letter-spacing: 0.1em;
  }
  .pg-step-t {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.3rem;
    margin: 0.55rem 0 0.5rem;
    color: var(--on-dark);
  }
  .pg-step-b { color: var(--on-dark-mut); line-height: 1.55; margin: 0; font-size: 0.98rem; }
  .pg-step-arrow {
    position: absolute;
    right: clamp(-1.6rem, -2vw, -0.9rem);
    top: 0;
    color: #33454f;
    font-size: 1.4rem;
  }

  /* ---- capabilities ---- */
  .pg-caps {
    background: var(--paper);
    color: var(--on-light);
    padding: clamp(3.5rem, 7vw, 6rem) clamp(1.25rem, 5vw, 5rem);
  }
  .pg-caps-head { max-width: 1120px; margin: 0 auto; }
  .pg-caps .pg-eyebrow { color: #0c8e87; }
  .pg-caps-grid {
    max-width: 1120px;
