---
// This page moved to its own domain. GitHub Pages can't emit a real 301, so
// this is the static-host redirect: meta refresh + canonical for crawlers,
// JS replace() so history doesn't trap the back button, and a plain link as
// the floor. The /coaching/*.jpg assets stay put — old iMessage/Slack link
// previews still fetch icon.jpg from this host.
const dest = 'https://coaching.prettygoodsoftware.llc/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pretty Good Video Coaching</title>
    <link rel="canonical" href={dest} />
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ dest }}>
      window.location.replace(dest);
    </script>
  </head>
  <body>
    <p style="font-family: system-ui; padding: 2rem;">
      This page moved to <a href={dest}>coaching.prettygoodsoftware.llc</a>.
    </p>
  </body>
</html>
